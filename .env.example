# Used only by domain_assistant.py when generating real RAG answers.
# Copy this file to .env, then replace the placeholder value.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Optional Gemini provider. If set, domain_assistant.py prefers Gemini.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
